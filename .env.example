# ─── Database ──────────────────────────────────────────────
# Render will inject its own Postgres connection string.
# Local dev: leave as SQLite file.
DATABASE_URL=

# ─── App URL ───────────────────────────────────────────────
# Public URL of your Render app (e.g. https://memoney.onrender.com).
# Next.js uses this for metadata/canonical tags; your app also uses it
# for internal fetch() calls from server components to API routes.
NEXTAUTH_URL=https://memoney.onrender.com

# ─── TrueLayer ─────────────────────────────────────────────
# Sandbox uses auth/api truelayer-sandbox.com; production uses truelayer.com.
TRUELAYER_ENV=sandbox
TRUELAYER_CLIENT_ID=
TRUELAYER_CLIENT_SECRET=
# ES512 private key for enterprise JWT auth (leave default for sandbox
# which uses client_secret auth). Never commit the actual key.
TRUELAYER_SIGNING_KEY_PATH=ec512-private-key.pem
# Verify TrueLayer webhook signatures (set in TrueLayer Console).
TRUELAYER_WEBHOOK_SECRET=
# OAuth redirect URI registered in TrueLayer Console (optional).
TRUELAYER_REDIRECT_URI=

# ─── Salt Edge ─────────────────────────────────────────────
SALTEDGE_APP_ID=
SALTEDGE_API_KEY=
SALTEDGE_API_BASE=https://api.saltedge.com/api/v6
SALTEDGE_CALLBACK_URL=

# ─── Trading 212 ───────────────────────────────────────────
# demo = paper trading / sandbox; live = real money
TRADING212_ENV=demo
TRADING212_API_KEY=
TRADING212_API_SECRET=
# Set to "false" to disable the integration entirely (optional)
TRADING212_ENABLED=true
